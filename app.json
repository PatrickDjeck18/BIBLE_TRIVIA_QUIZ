{
  "expo": {
    "name": "Bible Quiz",
    "slug": "bible-quiz",
    "version": "1.0.5",
    "orientation": "portrait",
    "scheme": "bible-quiz",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bible.quiz.trivia",
      "buildNumber": "5",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bible.quiz.trivia",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4253750298784159~9432659814",
          "iosAppId": "ca-app-pub-4253750298784159~5900608913"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#39FF14",
          "sounds": [],
          "mode": "production"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "773a7a76-7a37-47a2-9558-ce2ce93352d3"
      }
    },
    "owner": "amunazo"
  }
}
