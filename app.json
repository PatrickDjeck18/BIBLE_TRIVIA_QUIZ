{
  "expo": {
    "name": "Quiz Biblique",
    "slug": "quiz_biblique",
    "version": "1.0.2",
    "orientation": "portrait",
    "scheme": "quiz-biblique",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quiz.biblique.app",
      "buildNumber": "2",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.quiz.biblique.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4253750298784159~3493534470",
          "iosAppId": "ca-app-pub-4253750298784159~8362717771"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#39FF14",
          "sounds": [],
          "mode": "production"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4a9b7b7-890b-4f62-827d-58936deb664b"
      }
    }
  }
}